{
  "permissions": {
    "deny": [
      "Read(**/app/etc/env.php)",
      "Read(**/app/etc/env.php.*)",
      "Read(**/auth.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/id_*)",
      "Read(~/.composer/auth.json)"
    ]
  }
}
